+        path = tmp_path / "state.db"
+        writer = sqlite3.connect(path)
+        try:
+            assert writer.execute("PRAGMA journal_mode=WAL").fetchone()[0] == "wal"
+            writer.execute("PRAGMA wal_autocheckpoint=0")
+            writer.execute("CREATE TABLE messages(id INTEGER PRIMARY KEY,role TEXT,content TEXT,timestamp REAL)")
+            writer.execute("INSERT INTO messages VALUES(1,'user','before startup',1.0)")
+            writer.commit()
+            class Reader:
+                def get_messages(self, sid):
+                    with sqlite3.connect(path) as connection:
+                        rows = connection.execute("SELECT id,role,content,timestamp FROM messages ORDER BY id").fetchall()
+                    connection.close()
+                    return [dict(zip(("id","role","content","timestamp"), row)) for row in rows]
+                def close(self):
+                    pass
+            monkeypatch.setattr(mcp_serve, "_get_session_db", lambda: Reader())
+            monkeypatch.setattr(mcp_serve, "_load_sessions_index", lambda: {"fixture-dm": {"session_id": "fixture-session"}})
+            bridge = mcp_serve.EventBridge()
+            bridge._establish_baseline()
+            main_stat = path.stat()
+            writer.execute("INSERT INTO messages VALUES(2,'assistant','committed only to WAL',2.0)")
+            writer.commit()
+            os.utime(path, ns=(main_stat.st_atime_ns,main_stat.st_mtime_ns))
+            bridge._poll_once(Reader())
+            events = bridge.poll_events(after_cursor=0)["events"]
+            assert [e["content"] for e in events] == ["committed only to WAL"]
