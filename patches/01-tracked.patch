+def invoke_plugin_command(callback, raw_args, **context):
+    """Pass trusted caller context to opt-in handlers; keep raw-args handlers compatible."""
+    params=inspect.signature(callback).parameters
+    accepts_kwargs=any(p.kind is inspect.Parameter.VAR_KEYWORD for p in params.values())
