+def test_reader_cannot_finish_before_session_is_registered(monkeypatch):
+    """Force completion inside Thread.start, without scheduling or sleeps."""
+    from tools.process_registry import ProcessRegistry, ProcessSession
+    import tools.process_registry as module
+
+    reg = ProcessRegistry()
+    monkeypatch.setattr(reg, "_write_checkpoint", lambda: None)
+    class InlineThread:
+        def __init__(self, *, target, args, **kwargs):
+            self.target, self.args = target, args
+        def start(self):
+            self.target(*self.args)
+    monkeypatch.setattr(module.threading, "Thread", InlineThread)
+    session = ProcessSession(id="proc_inline", command="echo done", task_id="default",
+                             notify_on_complete=True)
+    reg._track_started(session, lambda s: reg._finish_exited(s, 0), "inline-reader")
+    assert session.id not in reg._running
+    assert reg._finished[session.id] is session
+    assert reg.completion_queue.qsize() == 1
+
