+def _read_state_db_mtime() -> tuple:
+    """Cheap change token for both rollback-journal and WAL-backed profiles.
+    WAL commits do not update the main database until a checkpoint."""
+    database = _hermes_home() / "state.db"
+    signature = []
+    for path in (database, database.with_name(database.name + "-wal")):
+        try:
+            st = path.stat()
+            signature.append((st.st_ino, st.st_mtime_ns, st.st_size))
+        except OSError:
+            signature.append(None)
+    return tuple(signature)
 
 
