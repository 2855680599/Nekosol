# All integration and external action gates start disabled.
# Public names are NYAIRO_*; each block lists the legacy CHIYO_* spelling that is
# still read when the NYAIRO_* name is unset. Do not set both with different values.
NYAIRO_NATIVE_LIFE_ENABLED=false
NYAIRO_NATIVE_WORLD_BODY_ENABLED=false
NYAIRO_NATIVE_LIFE_SUPPLY_ENABLED=false
NYAIRO_NATIVE_MEMORY_CONTEXT_ENABLED=false
NYAIRO_NATIVE_MEMORY_CONTEXT_MODE=OFF
NYAIRO_LIFE_INTEGRATION_MODE=off
NYAIRO_LIFE_PRODUCTION_CUTOVER=off
LIFE_RUNTIME_ENABLED=false
AGENCY_ENABLED=false
ACTION_EXECUTION_ENABLED=false
PROACTIVE_ENABLED=false
INQUIRY_ADMISSION=OFF
REAL_WORKSPACE_PROVISION=OFF
REAL_ARTIFACT_ACTION=OFF

# Legacy spelling (kept working):
# CHIYO_NATIVE_LIFE_ENABLED / CHIYO_NATIVE_WORLD_BODY_ENABLED
# CHIYO_NATIVE_LIFE_SUPPLY_ENABLED / CHIYO_NATIVE_MEMORY_CONTEXT_ENABLED
# CHIYO_NATIVE_MEMORY_CONTEXT_MODE / CHIYO_LIFE_INTEGRATION_MODE
# CHIYO_LIFE_PRODUCTION_CUTOVER
