# Fill locally. Do not commit the resulting .env file.
# Public names are NYAIRO_*; the legacy CHIYO_* spelling keeps working and the
# launcher maps NYAIRO_* onto it, so a mixed configuration is fine.
NYAIRO_MODEL=YOUR_MODEL_NAME
NYAIRO_MODEL_ENDPOINT=https://api.example.invalid/v1/chat/completions
NYAIRO_MODEL_BASE_URL=https://api.example.invalid/v1
NYAIRO_MODEL_API_KEY=
TELEGRAM_BOT_TOKEN=

# Legacy spelling of the same three settings (still read when NYAIRO_* is unset):
# CHIYO_MODEL=YOUR_MODEL_NAME
# CHIYO_MODEL_ENDPOINT=https://api.example.invalid/v1/chat/completions
# CHIYO_MODEL_BASE_URL=https://api.example.invalid/v1
# CHIYO_MODEL_API_KEY=
